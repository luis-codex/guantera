<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/hint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:maxLines="2" />
        </LinearLayout>
        <Button
            android:id="@+id/cancel"
            style="@style/Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            
            android:text="@string/lg_cancel" />
        <Button
            android:id="@+id/delete"
            style="@style/Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            android:visibility="gone"
            android:text="@string/mt_delete_item" />
        <Button
            android:id="@+id/save"
            style="@style/Control.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            
            android:text="@string/lg_save" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.TextFieldView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                
                app:fieldLabel="@string/mt_f_name" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/intervalKm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                
                app:fieldLabel="@string/mt_f_interval_km" />
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/intervalMonths"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                app:fieldLabel="@string/mt_f_interval_months" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/lastKm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                
                app:fieldLabel="@string/mt_f_last_km" />
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/lastDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                app:fieldLabel="@string/mt_f_last_date" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/fixedDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                
                app:fieldLabel="@string/mt_f_fixed" />
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/touch_gap"
                android:layout_weight="1" />
        </LinearLayout>
        </LinearLayout>
        <app.guantera.ui.components.NumberPadView
            android:id="@+id/pad"
            android:layout_width="@dimen/pad_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/block_gap" />
    </LinearLayout>
</LinearLayout>
