<?xml version="1.0" encoding="utf-8"?>
<!-- Un mes de Año o Rango: nombre, total y una barra proporcional al mes más fuerte del período. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_day"
    android:gravity="center_vertical"
    android:minHeight="@dimen/cell_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/s12"
    android:paddingTop="@dimen/s8"
    android:paddingEnd="@dimen/s12"
    android:paddingBottom="@dimen/s12">
    <TextView
        android:id="@+id/name"
        style="@style/Text.Cell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1" />
    <TextView
        android:id="@+id/total"
        style="@style/Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s4"
        android:maxLines="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_thickness"
        android:layout_marginTop="@dimen/s8"
        android:orientation="horizontal"
        android:weightSum="1">
        <View
            android:id="@+id/barFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bar_fill" />
        <View
            android:id="@+id/barEmpty"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
