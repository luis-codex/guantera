<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <app.guantera.ui.components.SectionHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionLabel="@string/nav_parked"
        app:sectionNumber="@string/section_parked" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_gap"
                android:text="@string/parked_question" />

            <LinearLayout
                android:id="@+id/savedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap"
                    android:baselineAligned="true"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/time"
                        style="@style/Text.Figure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/age"
                        style="@style/Text.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/s24"
                        android:maxLines="1"
                        android:textColor="@color/ink_secondary" />
                </LinearLayout>

                <app.guantera.ui.components.LabelValueRowView
                    android:id="@+id/rowNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/block_gap"
                    app:rowLabel="@string/parked_note" />

                <app.guantera.ui.components.LabelValueRowView
                    android:id="@+id/rowCoordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/row_gap"
                    app:rowLabel="@string/parked_coordinates" />

                <app.guantera.ui.components.LabelValueRowView
                    android:id="@+id/rowAccuracy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/row_gap"
                    app:rowLabel="@string/parked_accuracy" />

                <TextView
                    android:id="@+id/lastSignal"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/row_gap"
                    android:maxLines="2"
                    android:text="@string/parked_last_signal"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap_large"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parked_note" />
                <EditText
                    android:id="@+id/noteField"
                    style="@style/Field.Note"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="@dimen/s8"
                    android:hint="@string/parked_note_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s48"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Text.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parked_empty" />
                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s8"
                    android:text="@string/parked_empty_hint" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/error"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/s8"
                android:maxLines="2"
                android:textColor="@color/signal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/saveHere"
                    style="@style/Control.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="@string/parked_save_here" />
                <Button
                    android:id="@+id/editNote"
                    style="@style/Control.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/button_gap_parked" />
                <Button
                    android:id="@+id/saveNote"
                    style="@style/Control.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="@string/parked_note_save"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/cancelNote"
                    style="@style/Control.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/button_gap_parked"
                    android:text="@string/parked_note_cancel"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stoppedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stopped_question"
                    android:textColor="@color/ink" />
                <Button
                    android:id="@+id/stoppedYes"
                    style="@style/Control.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:text="@string/stopped_yes" />
                <Button
                    android:id="@+id/stoppedNo"
                    style="@style/Control.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/button_gap_parked"
                    android:text="@string/stopped_no" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qrGroup"
            android:layout_width="@dimen/qr_size"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/block_gap_large"
            android:layout_marginTop="@dimen/inner_gap"
            android:orientation="vertical">
            <app.guantera.ui.components.QrView
                android:id="@+id/qr"
                android:layout_width="@dimen/qr_size"
                android:layout_height="@dimen/qr_size"
                android:contentDescription="@string/parked_qr_description" />
            <TextView
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/button_gap_parked"
                android:text="@string/parked_qr_title"
                android:textColor="@color/ink" />
            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s8"
                android:text="@string/parked_qr_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
