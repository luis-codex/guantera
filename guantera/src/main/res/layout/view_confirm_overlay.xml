<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="@dimen/confirm_panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_confirm_panel"
        android:orientation="vertical"
        android:padding="@dimen/s24">
        <TextView
            android:id="@+id/title"
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/body"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s8" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:orientation="horizontal">
            <Button
                android:id="@+id/confirm"
                style="@style/Control.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1" />
            <Button
                android:id="@+id/cancel"
                style="@style/Control.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/touch_gap"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</merge>
