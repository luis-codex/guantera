<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <app.guantera.ui.components.SectionHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionLabel="@string/nav_home"
        app:sectionNumber="@string/section_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inner_gap"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_question" />
        <TextView
            android:id="@+id/verdict"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/ink" />
    </LinearLayout>

    <app.guantera.ui.components.BannerView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/block_gap"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include
            android:id="@+id/cardToday"
            layout="@layout/view_home_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <include
            android:id="@+id/cardMaintenance"
            layout="@layout/view_home_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/card_gap"
            android:layout_weight="1" />
        <include
            android:id="@+id/cardParked"
            layout="@layout/view_home_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/card_gap"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/playbackStatus"
            style="@style/Text.Label"
            android:layout_width="@dimen/playback_status_width"
            android:layout_height="wrap_content"
            android:textColor="@color/ink" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/button_gap_parked"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/playbackTitle"
                style="@style/Text.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
            <TextView
                android:id="@+id/playbackSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
        <app.guantera.ui.components.TransportControlsView
            android:id="@+id/transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
