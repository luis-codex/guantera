<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <TextView
        android:id="@+id/kicker"
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s16" />

    <TextView
        android:id="@+id/message"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s16" />

    <EditText
        android:id="@+id/input"
        style="@style/Text.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="@dimen/block_gap"
        android:background="@drawable/bg_button_secondary"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:maxLines="1"
        android:paddingStart="@dimen/s24"
        android:paddingEnd="@dimen/s24"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s8"
        android:textColor="@color/signal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/footer"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:visibility="gone" />
</LinearLayout>
