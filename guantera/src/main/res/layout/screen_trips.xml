<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h">

    <app.guantera.ui.components.SectionHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionLabel="@string/nav_trips"
        app:sectionNumber="@string/section_trips" />

    <LinearLayout
        android:id="@+id/listGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_gap"
            android:text="@string/trips_question" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/figure_row_height"
            android:layout_marginTop="@dimen/block_gap"
            android:orientation="horizontal">
            <app.guantera.ui.components.FigureCellView
                android:id="@+id/today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cellLabel="@string/trips_today" />
            <app.guantera.ui.components.FigureCellView
                android:id="@+id/week"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                app:cellLabel="@string/trips_week" />
            <app.guantera.ui.components.FigureCellView
                android:id="@+id/month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                app:cellLabel="@string/trips_month" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/block_gap"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbarSize="@dimen/s4"
            android:scrollbarThumbVertical="@color/line_strong"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            style="@style/Text.Primary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/s48"
            android:layout_weight="1"
            android:text="@string/trips_empty"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/detail"
        layout="@layout/view_trip_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
