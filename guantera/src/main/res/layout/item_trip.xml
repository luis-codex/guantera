<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_min"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding">

    <TextView
        android:id="@+id/day"
        style="@style/Text.Primary"
        android:layout_width="@dimen/trip_column_day"
        android:layout_height="wrap_content"
        android:maxLines="1" />

    <TextView
        android:id="@+id/time"
        style="@style/Text.Secondary"
        android:layout_width="@dimen/trip_column_time"
        android:layout_height="wrap_content"
        android:maxLines="1" />

    <TextView
        android:id="@+id/duration"
        style="@style/Text.Secondary"
        android:layout_width="@dimen/trip_column_duration"
        android:layout_height="wrap_content"
        android:maxLines="1" />

    <TextView
        android:id="@+id/estimated"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cell"
        android:paddingStart="@dimen/s8"
        android:paddingTop="@dimen/s4"
        android:paddingEnd="@dimen/s8"
        android:paddingBottom="@dimen/s4"
        android:text="@string/trips_estimated"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/km"
        style="@style/Text.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="lnum"
        android:maxLines="1" />

    <TextView
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s24"
        android:text="@string/trips_see"
        android:textColor="@color/ink" />
</LinearLayout>
