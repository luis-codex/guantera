<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <app.guantera.ui.components.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionLabel="@string/nav_expenses"
                app:sectionNumber="@string/section_expenses" />
            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_gap"
                android:text="@string/expenses_question" />
            <TextView
                android:id="@+id/hint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
        <Button
            android:id="@+id/add"
            style="@style/Control.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            android:text="@string/ex_new" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/block_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/expenses_side_width"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <app.guantera.ui.components.FigureCellView
                android:id="@+id/costCell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding"
                app:cellFigureSize="@dimen/text_figure"
                app:cellLabel="@string/ex_cost_per_km" />
            <TextView
                android:id="@+id/costNote"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inner_gap"
                android:visibility="gone" />
            <app.guantera.ui.components.LabelValueRowView
                android:id="@+id/total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/block_gap"
                app:rowLabel="@string/ex_total" />
            <app.guantera.ui.components.LabelValueRowView
                android:id="@+id/kilometers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                app:rowLabel="@string/ex_km" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
        android:orientation="horizontal">
                <app.guantera.ui.components.ChoiceButton
                    android:id="@+id/periodMonth"
                    style="@style/Control.Button.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:text="@string/ex_period_month" />
                <app.guantera.ui.components.ChoiceButton
                    android:id="@+id/periodYear"
                    style="@style/Control.Button.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/touch_gap"
                    android:layout_weight="1"
                    android:text="@string/ex_period_year" />
                <app.guantera.ui.components.ChoiceButton
                    android:id="@+id/periodAll"
                    style="@style/Control.Button.Choice"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/touch_gap"
                    android:layout_weight="1"
                    android:text="@string/ex_period_all" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/block_gap"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/emptyBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Text.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ex_empty" />
                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inner_gap"
                    android:text="@string/ex_empty_hint" />
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <app.guantera.ui.components.PagerBarView
                android:id="@+id/pager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
