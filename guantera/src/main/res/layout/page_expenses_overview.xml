<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <LinearLayout
        android:layout_width="@dimen/history_side_width"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:sectionLabel="@string/nav_expenses"
            app:sectionNumber="@string/section_expenses" />
        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inner_gap"
            android:maxLines="1"
            android:text="@string/expenses_question" />
        <TextView
            android:id="@+id/hint"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s4"
            android:maxLines="1"
            android:visibility="gone" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/costRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            app:rowLabel="@string/ex_cost_per_km" />
        <TextView
            android:id="@+id/costNote"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s4"
            android:maxLines="1"
            android:text="@string/ex_too_few"
            android:visibility="gone" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            app:rowLabel="@string/ex_total" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/kilometers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            app:rowLabel="@string/ex_km" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/add"
            style="@style/Control.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/ex_new" />
        <app.guantera.ui.history.HistoryControlsView
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap" />
    </LinearLayout>

    <app.guantera.ui.history.HistoryBodyView
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/block_gap"
        android:layout_weight="1"
        app:historyEmpty="@string/ex_empty_in"
        app:historyEmptyHint="@string/ex_empty_hint" />
</LinearLayout>
