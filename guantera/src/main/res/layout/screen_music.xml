<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">

    <app.guantera.ui.components.SectionHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:sectionLabel="@string/nav_music"
        app:sectionNumber="@string/section_music" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/block_gap"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Qué suena. Todo con altura reservada: ningún estado mueve lo demás. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/block_gap_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackApp"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="1" />

            <TextView
                android:id="@+id/trackTitle"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:ellipsize="end"
                android:maxLines="3" />

            <TextView
                android:id="@+id/trackArtist"
                style="@style/Text.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ink_secondary" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Invisible (no gone) cuando no hace falta, para no mover nada. -->
            <Button
                android:id="@+id/accessAction"
                style="@style/Control.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginBottom="@dimen/block_gap"
                android:text="@string/music_access_action"
                android:visibility="invisible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line"
                android:background="@color/line_soft" />

            <!-- Diagnóstico: una línea de altura reservada. -->
            <TextView
                android:id="@+id/statusLine"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:ellipsize="end"
                android:lines="1" />
        </LinearLayout>

        <!-- Controles, anclados abajo. -->
        <LinearLayout
            android:layout_width="@dimen/music_controls_width"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/music_transport_height"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/previous"
                    style="@style/Control.Transport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/transport_previous"
                    android:src="@drawable/ic_previous_lg" />
                <ImageButton
                    android:id="@+id/playPause"
                    style="@style/Control.Transport.Primary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/touch_gap"
                    android:layout_weight="1.5"
                    android:contentDescription="@string/transport_play"
                    android:src="@drawable/ic_play_lg" />
                <ImageButton
                    android:id="@+id/next"
                    style="@style/Control.Transport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/touch_gap"
                    android:layout_weight="1"
                    android:contentDescription="@string/transport_next"
                    android:src="@drawable/ic_next_lg" />
            </LinearLayout>

            <!-- Volumen: grupo aparte, con su filete y su rótulo. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line"
                android:layout_marginTop="@dimen/block_gap_large"
                android:background="@color/line_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/volume_label" />
                <TextView
                    android:id="@+id/volumeValue"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/volumeDown"
                    style="@style/Control"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:contentDescription="@string/control_volume_down"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_l_minus" />
                    <TextView
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/icon_gap_inline"
                        android:fontFamily="@font/space_grotesk_medium"
                        android:text="@string/music_volume_down"
                        android:textColor="@color/ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/volumeUp"
                    style="@style/Control"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/touch_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:contentDescription="@string/control_volume_up"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_l_plus" />
                    <TextView
                        style="@style/Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/icon_gap_inline"
                        android:fontFamily="@font/space_grotesk_medium"
                        android:text="@string/music_volume_up"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mute"
                style="@style/Control"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/touch_gap"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/muteIcon"
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_l_volume_off" />
                <TextView
                    android:id="@+id/muteLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/icon_gap_inline"
                    android:fontFamily="@font/space_grotesk_medium"
                    android:text="@string/volume_mute"
                    android:textColor="@color/ink" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
