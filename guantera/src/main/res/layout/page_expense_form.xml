<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin_h"
    android:paddingTop="@dimen/screen_margin_v"
    android:paddingEnd="@dimen/screen_margin_h"
    android:paddingBottom="@dimen/screen_margin_v">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/hint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s4"
                android:maxLines="2" />
        </LinearLayout>
        <Button
            android:id="@+id/cancel"
            style="@style/Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            
            android:text="@string/lg_cancel" />
        <Button
            android:id="@+id/delete"
            style="@style/Control.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            android:visibility="gone"
            android:text="@string/ex_delete" />
        <Button
            android:id="@+id/save"
            style="@style/Control.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/touch_gap"
            
            android:text="@string/lg_save" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                
                app:fieldLabel="@string/ex_f_amount" />
            <app.guantera.ui.components.FieldCellView
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                app:fieldLabel="@string/ex_f_date" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catFuel"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/ex_cat_fuel" />
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catMaintenance"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                android:text="@string/ex_cat_maintenance" />
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catInsurance"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                android:text="@string/ex_cat_insurance" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catTolls"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/ex_cat_tolls" />
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catParking"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                android:text="@string/ex_cat_parking" />
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catWashing"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/touch_gap"
                android:text="@string/ex_cat_washing" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/touch_gap"
            android:baselineAligned="false"
        android:orientation="horizontal">
            <app.guantera.ui.components.ChoiceButton
                android:id="@+id/catOther"
                style="@style/Control.Button.Choice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/ex_cat_other" />
            <app.guantera.ui.components.TextFieldView
                android:id="@+id/note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="@dimen/touch_gap"
                app:fieldLabel="@string/ex_f_note" />
        </LinearLayout>
        </LinearLayout>
        <app.guantera.ui.components.NumberPadView
            android:id="@+id/pad"
            android:layout_width="@dimen/pad_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/block_gap" />
    </LinearLayout>
</LinearLayout>
