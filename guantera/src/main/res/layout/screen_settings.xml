<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/s24"
            android:paddingTop="@dimen/s16"
            android:paddingEnd="@dimen/s24"
            android:paddingBottom="@dimen/s16">

            <app.guantera.ui.components.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionLabel="@string/nav_settings"
                app:sectionNumber="@string/section_settings" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s8"
                android:text="@string/settings_question" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/settings_group_car" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/rowCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16"
            app:rowLabel="@string/settings_model" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowOdometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowCurrency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/settings_group_gps" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/settings_group_datetime" />

        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />

        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/rowZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16"
            app:rowLabel="@string/settings_timezone" />

        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/settings_group_boot" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/settings_group_data" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/rowBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16"
            app:rowLabel="@string/settings_last_backup" />
        <app.guantera.ui.components.LabelValueRowView
            android:id="@+id/rowExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16"
            app:rowLabel="@string/settings_last_export" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowExportAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/rowImportAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
                <LinearLayout
                    android:id="@+id/demoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

        <app.guantera.ui.components.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s32"
            app:sectionLabel="@string/demo_section" />
        <app.guantera.ui.components.ListRowView
            android:id="@+id/demoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s16"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/s24"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/settings_music_title" />
                <TextView
                    android:id="@+id/musicSubtitle"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/s4"
                    android:maxLines="2" />
            </LinearLayout>
            <Button
                android:id="@+id/musicSample"
                style="@style/Control.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:minWidth="200dp"
                android:text="@string/settings_music_sample" />
            <Button
                android:id="@+id/musicReal"
                style="@style/Control.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/touch_gap"
                android:minWidth="200dp"
                android:text="@string/settings_music_real" />
        </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/s24"
        android:paddingTop="@dimen/s16"
        android:paddingEnd="@dimen/s24"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/s16">

            <TextView
                android:id="@+id/promptTitle"
                style="@style/Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/promptMessage"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s8" />

            <EditText
                android:id="@+id/promptInput"
                style="@style/Text.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/s16"
                android:background="@drawable/bg_button_secondary"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="number"
                android:maxLength="9"
                android:maxLines="1"
                android:paddingStart="@dimen/s24"
                android:paddingEnd="@dimen/s24"
                android:visibility="gone" />

            <TextView
                android:id="@+id/promptError"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s8"
                android:textColor="@color/signal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/s24"
                android:gravity="end"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/promptCancel"
                    style="@style/Control.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min" />
                <Button
                    android:id="@+id/promptAccept"
                    style="@style/Control.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/touch_gap" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
